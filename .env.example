# Build-time variables (Workers Builds → Settings → Build → Variables).
# PUBLIC_* values end up in the page, so nothing secret here.

# Donation link (Stripe Payment Link, Ko-fi, PayPal.me, Buy Me a Coffee...).
# "{amt}" is replaced with the tier amount (5, 20, 100) if your provider takes one in the URL.
# The donate button stays visible when empty; the tiers just say payments aren't hooked up yet.
PUBLIC_DONATE_URL=

# Leave unset until launch: pages are noindex and robots.txt disallows everything.
PUBLIC_SITE_INDEXABLE=
